 {
     SWSS_LOG_ENTER();
 
+    // ARGV[4] is the monotonic start of this poll cycle, captured before
+    // collectCounters().  A plugin can only stamp its own clock when it is
+    // invoked, which is after stat collection, so consecutive stamps differ by
+    // the cycle period plus the change in collection time.  That makes
+    // collection jitter indistinguishable from poll jitter, and lets a
+    // measured interval come out shorter than the configured one.
+    //
+    // ARGV[5] is how long stat collection took for this cycle.  It is the term
+    // that scales with the number of polled objects, so it is what decides
+    // whether a given poll interval is sustainable at a given scale; without
+    // it a plugin can see that the cycle overran but not why.
     const std::vector<std::string> argv =
     {
         std::to_string(counters_db.getDbId()),
         COUNTERS_TABLE,
-        std::to_string(m_pollInterval)
+        std::to_string(m_pollInterval),
+        std::to_string(cycleStartUs),
+        std::to_string(collectUs)
     };
 
