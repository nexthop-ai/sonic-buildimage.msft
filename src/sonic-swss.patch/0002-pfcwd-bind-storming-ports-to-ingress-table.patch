@@ -460,6 +465,8 @@ void PfcWdAclHandler::createPfcAclTable(sai_object_id_t port, string strTable, b
         return;
     }
 
+    m_ownedAclTables.insert(strTable);
+
     // Link port only for ingress ACL table or unshared egress ACL table.
     if (ingress || !shared_egress_acl_table)
     {
@@ -532,6 +539,42 @@ std::string PfcWdAclHandler::ingressRuleName(uint8_t queueId)
     return "Rule_PfcWdAclHandler_" + std::to_string(queueId);
 }
 
+void PfcWdAclHandler::bindIngressPort(const std::string &strTable, sai_object_id_t port)
+{
+    SWSS_LOG_ENTER();
+
+    // Never touch a table PFCWD only borrowed; its owner manages its bindings.
+    if (m_ownedAclTables.find(strTable) == m_ownedAclTables.end())
+    {
+        return;
+    }
+
+    auto found = m_aclTables.find(strTable);
+    if (found == m_aclTables.end())
+    {
+        return;
+    }
+
+    AclTable &table = found->second;
+    auto it = table.ports.find(port);
+    if (it != table.ports.end() && it->second != SAI_NULL_OBJECT_ID)
+    {
+        // Already bound; binding again would leak the previous group member.
+        return;
+    }
+
+    if (it == table.ports.end())
+    {
+        table.link(port);
+    }
+
+    if (!table.bind(port))
+    {
+        SWSS_LOG_ERROR("Failed to bind port oid:0x%" PRIx64 " to PFCWD ingress ACL table %s",
+                       port, strTable.c_str());
+    }
+}
+
 void PfcWdAclHandler::deferIngressPort(uint8_t queueId, sai_object_id_t port, bool add)
 {
     SWSS_LOG_ENTER();
@@ -611,6 +654,7 @@ void PfcWdAclHandler::flush(void)
 }
 
 std::map<std::string, AclTable> PfcWdAclHandler::m_aclTables;
